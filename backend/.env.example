# ==============================================================================
# AgentGuard Environment Configuration (.env.example)
# Copy this file to .env and supply your secret keys and credentials.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Application Security & JWT Authentication
# Generate a secure secret in production using: openssl rand -hex 32
SECRET_KEY=agentguard_dev_secret_key_change_in_production_32charsmin!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Async SQLite with WAL mode by default)
# For production PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/agentguard
DATABASE_URL=sqlite+aiosqlite:///./agentguard.db
DB_BUSY_TIMEOUT=5000

# CORS Configuration (JSON array of allowed frontend origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8000"]

# ------------------------------------------------------------------------------
# LLM Providers for LangGraph Evaluation Pipeline
# Primary: ChatGroq (fast inference for evaluation judge)
# Fallback: ChatGoogleGenerativeAI (Gemini)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY_SECONDARY=

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Alerting & SMTP Email Configuration
# ------------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@agentguard.dev
SMTP_PASSWORD=your_app_password
SMTP_FROM=alerts@agentguard.dev
SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# Ingest Rate Limiting (Token Bucket per API Key)
# ------------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
